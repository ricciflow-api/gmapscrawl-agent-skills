        "operation_id": "createPlaceReviews",
        "success_status": 202
      },
      "mcp": {
        "tool_name": "get_google_maps_reviews",
        "title": "Get Google Maps reviews",
        "description": "Create one durable, billable request for exactly one positive-int32 review source page, returning at most 10 reviews. Empty pages still consume one admitted unit.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true
        }
      },
      "requires_client_request_id": true,
