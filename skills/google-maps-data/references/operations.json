{
  "schema_version": "2026-09-22",
  "api_version": "1.0.0",
  "base_url": "https://gmapscrawl.com/api/v1",
  "openapi_url": "https://gmapscrawl.com/api/v1/openapi.json",
  "mcp_url": "https://gmapscrawl.com/api/mcp",
  "operations": {
    "places.search": {
      "required_scope": "scrapes:write",
      "capability": "search",
      "request_units": 1,
      "maximum_input_bytes": 16384,
      "availability": "server_authoritative",
      "input_schema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200,
            "example": "coffee shops in Seattle"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 1
          },
          "ll": {
            "type": "string",
            "pattern": "^@-?(?:90(?:\\.0+)?|(?:[0-8]?\\d)(?:\\.\\d+)?),-?(?:180(?:\\.0+)?|(?:1[0-7]\\d|\\d?\\d)(?:\\.\\d+)?),(?:[1-9]|1\\d|2[01])z$",
            "example": "@47.6062,-122.3321,12z"
          },
          "hl": {
            "type": "string",
            "default": "en",
            "example": "en"
          },
          "gl": {
            "type": "string",
            "pattern": "^[A-Za-z]{2}$",
            "example": "us"
          },
          "extra": {
            "type": "boolean",
            "default": false
          },
          "client_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "webhook_endpoint_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false
      },
      "example_input": {
        "q": "coffee shops in Seattle",
        "page": 1,
        "hl": "en",
        "gl": "us",
        "extra": false
      },
      "rest": {
        "method": "POST",
        "path": "/scrapes",
        "operation_id": "createPlacesSearch",
        "success_status": 202
      },
      "mcp": {
        "tool_name": "search_google_maps",
        "title": "Search Google Maps",
        "description": "Create one durable, billable Google Maps search request for one source page. The result may be asynchronous; use get_scrape_job and get_scrape_results with the returned job ID.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true
        }
      },
      "requires_client_request_id": true,
      "allows_wait": true,
      "request_shape": "scrape_envelope",
      "path_parameters": [],
      "query_parameters": []
    },
